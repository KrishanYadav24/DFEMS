# =============================================================================
# DFEMS (Digital Forensic Evidence Management System) Root Configuration
# =============================================================================
# Copy this file to '.env' in the project root or in 'backend/.env'.
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Oracle Database 26ai Free (FREEPDB1)
DB_USER=dfems_user
DB_PASSWORD=your_secure_oracle_password_here
DB_CONNECT_STRING=localhost:1521/FREEPDB1

# Connection Pool Tuning
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=2
DB_POOL_TIMEOUT=60
DB_QUEUE_TIMEOUT=5000

# Security & Session Settings
JWT_SECRET=change_this_to_a_random_secure_secret_in_production
JWT_EXPIRES_IN=8h

